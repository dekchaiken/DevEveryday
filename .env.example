# ---- Admin login (/admin) ----
# รหัสผ่านที่ใช้เข้าหน้า admin (ตั้งเองให้คาดเดายาก)
ADMIN_PASSWORD=change-me
# คีย์สำหรับเซ็น session cookie (ยาวอย่างน้อย 32 ตัวอักษร)
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string-32chars+

# ---- GitHub (ใช้บันทึกการแก้ไขข้อมูลลง repo แล้ว Vercel จะ deploy ใหม่ให้อัตโนมัติ) ----
# Fine-grained token ที่มีสิทธิ์ Contents: Read and write กับ repo นี้เท่านั้น
GITHUB_TOKEN=
GITHUB_REPO=dekchaiken/DevEveryday
GITHUB_BRANCH=main
